
{
  "1": {
    "en": "When I am alone and have nothing to accomplish, what do I feel?",
    "fr": "Lorsque je suis seul et que je n'ai rien à accomplir, qu'est-ce que je ressens ?"
  },
  "2": {
    "en": "Do I sometimes feel that I have to become somebody to deserve to exist?",
    "fr": "Ai-je parfois l'impression que je dois devenir quelqu'un pour avoir le droit d'exister ?"
  },
  "3": {
    "en": "What am I trying to prove, and to whom?",
    "fr": "Qu'est-ce que j'essaie de prouver, et à qui ?"
  },
  "4": {
    "en": "Can I appreciate my life when nothing extraordinary is happening?",
    "fr": "Est-ce que je sais apprécier ma vie lorsqu'il ne se passe rien d'extraordinaire ?"
  },
  "5": {
    "en": "What am I afraid of discovering if I stop telling myself stories about who I am?",
    "fr": "Qu'est-ce que je crains de découvrir si je cesse de me raconter des histoires sur moi-même ?"
  },
  "6": {
    "en": "What image of myself am I trying to preserve?",
    "fr": "Quelle image de moi-même est-ce que j'essaie de préserver ?"
  },
  "7": {
    "en": "Do I sometimes confuse my personal worth with my achievements?",
    "fr": "Est-ce que je confonds parfois ma valeur personnelle avec mes réussites ?"
  },
  "8": {
    "en": "What would remain of my identity if I gave up my ambitions?",
    "fr": "Qu'est-ce qui resterait de mon identité si je renonçais à mes ambitions ?"
  },
  "9": {
    "en": "Do I spend more time watching myself live than actually living?",
    "fr": "Est-ce que je me regarde davantage vivre que je ne vis réellement ?"
  },
  "10": {
    "en": "In which situations do I naturally feel that I belong?",
    "fr": "Dans quelles situations est-ce que je me sens naturellement à ma place ?"
  },
  "11": {
    "en": "Why can the idea of growing older cause me so much anxiety?",
    "fr": "Pourquoi l'idée de vieillir peut-elle susciter autant d'inquiétude chez moi ?"
  },
  "12": {
    "en": "When did I start thinking that I had fallen behind in life?",
    "fr": "À quel moment ai-je commencé à penser que j'avais pris du retard dans ma vie ?"
  },
  "13": {
    "en": "Whose life path do I compare my own with?",
    "fr": "À qui est-ce que je compare ma trajectoire personnelle ?"
  },
  "14": {
    "en": "Which social expectations have I adopted without ever truly choosing them?",
    "fr": "Quelles attentes sociales ai-je intégrées sans jamais vraiment les choisir ?"
  },
  "15": {
    "en": "If nobody knew my age, would I live differently?",
    "fr": "Si personne ne connaissait mon âge, est-ce que je vivrais différemment ?"
  },
  "16": {
    "en": "What do I consider a successful life?",
    "fr": "Qu'est-ce que je considère comme une vie réussie ?"
  },
  "17": {
    "en": "Is it my own definition of success, or one I inherited from others?",
    "fr": "Est-ce ma propre définition de la réussite ou celle que j'ai héritée des autres ?"
  },
  "18": {
    "en": "What do I genuinely regret, beyond what I imagine I have missed?",
    "fr": "Qu'est-ce que je regrette réellement, au-delà de ce que j'imagine avoir manqué ?"
  },
  "19": {
    "en": "Can I look towards the future without seeing my past as a failure?",
    "fr": "Puis-je envisager l'avenir sans considérer mon passé comme un échec ?"
  },
  "20": {
    "en": "What could still surprise me in my own life?",
    "fr": "Qu'est-ce qui pourrait encore me surprendre dans ma propre vie ?"
  },
  "21": {
    "en": "Does my spiritual search help me live, or does it sometimes allow me to escape my life?",
    "fr": "Est-ce que ma recherche spirituelle m'aide à vivre ou me permet parfois de fuir ma vie ?"
  },
  "22": {
    "en": "Why do I sometimes need to give certain experiences an extraordinary meaning?",
    "fr": "Pourquoi ai-je parfois besoin de donner une signification exceptionnelle à certaines expériences ?"
  },
  "23": {
    "en": "Am I searching for truth, or for an experience that would make me feel different?",
    "fr": "Est-ce que je recherche la vérité ou une expérience qui me donnerait le sentiment d'être différent ?"
  },
  "24": {
    "en": "Can I accept that a profound experience remains mysterious and has no definitive conclusion?",
    "fr": "Puis-je accepter qu'une expérience profonde reste mystérieuse et sans conclusion définitive ?"
  },
  "25": {
    "en": "What distinction do I make between an inner experience and an objective truth?",
    "fr": "Quelle différence fais-je entre une expérience intérieure et une vérité objective ?"
  },
  "26": {
    "en": "Do I sometimes seek to feel chosen, initiated, or exceptional?",
    "fr": "Est-ce que je cherche parfois à me sentir élu, initié ou exceptionnel ?"
  },
  "27": {
    "en": "What does living spiritually mean to me without building a spiritual identity?",
    "fr": "Que signifie pour moi vivre spirituellement sans me construire une identité spirituelle ?"
  },
  "28": {
    "en": "Can I welcome mystery without trying to interpret everything?",
    "fr": "Puis-je accueillir le mystère sans chercher à tout interpréter ?"
  },
  "29": {
    "en": "What does meditation actually change in the way I live?",
    "fr": "Qu'est-ce que la méditation change concrètement dans ma manière de vivre ?"
  },
  "30": {
    "en": "Can I live an ordinary day without expecting it to reveal something?",
    "fr": "Suis-je capable de vivre une journée ordinaire sans lui demander de révéler quelque chose ?"
  },
  "31": {
    "en": "What do I truly expect from other people?",
    "fr": "Qu'est-ce que j'attends véritablement des autres ?"
  },
  "32": {
    "en": "Do I allow others to know me, or do I present them with an image of myself?",
    "fr": "Est-ce que je laisse les autres me connaître ou est-ce que je leur présente une image de moi ?"
  },
  "33": {
    "en": "What makes me feel vulnerable in a relationship?",
    "fr": "Qu'est-ce qui me rend vulnérable dans une relation ?"
  },
  "34": {
    "en": "Can I receive affection without feeling that I have to earn it?",
    "fr": "Est-ce que je sais recevoir de l'affection sans avoir l'impression de devoir la mériter ?"
  },
  "35": {
    "en": "What place do I give tenderness in my life?",
    "fr": "Quelle place est-ce que je donne à la tendresse dans mon existence ?"
  },
  "36": {
    "en": "What sometimes prevents me from forming connections with others?",
    "fr": "Qu'est-ce qui m'empêche parfois de créer des liens avec les autres ?"
  },
  "37": {
    "en": "Can I love someone without expecting them to fill an emptiness within me?",
    "fr": "Est-ce que je peux aimer quelqu'un sans attendre qu'il comble un manque en moi ?"
  },
  "38": {
    "en": "What is my relationship with solitude: is it a refuge, a source of suffering, or a form of freedom?",
    "fr": "Quelle relation ai-je avec la solitude : est-elle un refuge, une souffrance ou une liberté ?"
  },
  "39": {
    "en": "What could I offer others without seeking recognition in return?",
    "fr": "Qu'est-ce que je pourrais offrir aux autres sans chercher de reconnaissance en retour ?"
  },
  "40": {
    "en": "How do I recognize a relationship in which I can fully be myself?",
    "fr": "Comment est-ce que je reconnais une relation dans laquelle je peux être pleinement moi-même ?"
  },
  "41": {
    "en": "What do I genuinely enjoy about learning and discovery?",
    "fr": "Qu'est-ce qui me plaît réellement dans l'apprentissage et la découverte ?"
  },
  "42": {
    "en": "Can I learn without turning every improvement into an obligation to succeed?",
    "fr": "Est-ce que je peux apprendre sans transformer chaque progrès en obligation de réussir ?"
  },
  "43": {
    "en": "Which activity makes me feel alive, regardless of its usefulness?",
    "fr": "Quelle activité me donne le sentiment d'être vivant, indépendamment de son utilité ?"
  },
  "44": {
    "en": "What would I like to create if I were not afraid of being judged?",
    "fr": "Qu'est-ce que je voudrais créer si je n'avais pas peur du jugement ?"
  },
  "45": {
    "en": "Which part of my ambitions comes from desire, and which part comes from fear?",
    "fr": "Quelle part de mes ambitions vient du désir et quelle part vient de la peur ?"
  },
  "46": {
    "en": "How could I build a life that feels more like my own?",
    "fr": "Comment pourrais-je construire une vie qui me ressemble davantage ?"
  },
  "47": {
    "en": "What am I neglecting in the present because I am too busy thinking about the future?",
    "fr": "Qu'est-ce que je néglige dans le présent parce que je suis trop occupé à penser à l'avenir ?"
  },
  "48": {
    "en": "Which little things bring me simple and genuine joy?",
    "fr": "Quelles petites choses me procurent une joie simple et sincère ?"
  },
  "49": {
    "en": "If I stopped judging myself for a week, what would change in my daily life?",
    "fr": "Si je cessais de me juger pendant une semaine, qu'est-ce qui changerait dans mon quotidien ?"
  },
  "50": {
    "en": "What if I had nothing to become? What would I want to experience right now?",
    "fr": "Et si je n'avais rien à devenir, qu'aurais-je envie de vivre maintenant ?"
  }
